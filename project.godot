; Engine configuration file.
; Ruin Digger - Godot 4.6

config_version=5

[application]

config/name="Ruin Digger"
config/description="Break the ground. Wake what lies below. Get out richer."
config/version="0.2.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.035, 0.063, 1)
boot_splash/show_image=false

[autoload]

Balance="*res://src/autoload/balance.gd"
Settings="*res://src/autoload/settings.gd"
Progress="*res://src/autoload/progress.gd"
Audio="*res://src/autoload/audio.gd"
InputSetup="*res://src/autoload/input_setup.gd"
Game="*res://src/autoload/game.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=980.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=false
environment/defaults/default_clear_color=Color(0.043, 0.035, 0.063, 1)
anti_aliasing/quality/msaa_2d=0
