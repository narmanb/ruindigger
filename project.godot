; Engine configuration file.
; RUIN DIGGER - Godot 4.6.x
; Generated/maintained as plain text so the project can be edited by hand.

config_version=5

[application]

config/name="Ruin Digger"
config/description="A destructible-terrain 2D digging-action exploration roguelite."
config/version="0.1.0"
run/main_scene="res://src/ui/title_screen.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.035, 0.055, 1)
boot_splash/show_image=false

[autoload]

InputSetup="*res://src/autoload/input_setup.gd"
Balance="*res://src/autoload/balance.gd"
SaveManager="*res://src/autoload/save_manager.gd"
GameState="*res://src/autoload/game_state.gd"
Fx="*res://src/autoload/fx.gd"
Audio="*res://src/autoload/audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/resizable=true
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=900.0

[rendering]
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false
environment/defaults/default_clear_color=Color(0.043, 0.035, 0.055, 1)
anti_aliasing/quality/msaa_2d=0
